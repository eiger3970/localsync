platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # :static linkage (not the default dynamic-framework build) - the two
  # earlier fixes here (-all_load, disabled strip) only touched the Pods'
  # own targets. git2dart_binaries's whole approach on iOS depends on
  # DynamicLibrary.process() (confirmed by reading its actual source,
  # lib/src/util.dart) - it needs libgit2/libssh2/OpenSSL truly merged
  # into the main Runner binary, not built as a separate dynamic
  # framework, which is what plain use_frameworks! does. Untested - out
  # of session time to verify on a real device.
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Fix for Dart FFI dlsym symbol lookup failing in Release builds
      # ("Failed to lookup symbol 'git_libgit2_init'") - a known Dart FFI
      # issue (dart-lang/native#897): Release-mode dead-code-stripping
      # removes C symbols not directly referenced by Swift/ObjC, even
      # when genuinely statically linked (git2dart/libgit2/libssh2/
      # OpenSSL via git2dart_binaries). -all_load forces the linker to
      # keep every symbol from every linked static library. Confirmed
      # 2026-08-08 real-device run hit this exact error.
      config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
      config.build_settings['OTHER_LDFLAGS'] << '-all_load'

      # -all_load alone wasn't enough (confirmed 2026-08-08, same error
      # persisted after it) - it only stops the linker dropping whole
      # unreferenced object files during linking. Separately, Release
      # builds strip the symbol table from the FINAL installed binary
      # afterward, which is what dlsym() (Dart FFI's runtime lookup
      # mechanism) actually depends on. Disabling that post-link
      # stripping is the other half of this fix.
      config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
      config.build_settings['DEPLOYMENT_POSTPROCESSING'] = 'NO'
    end
  end

  # 2026-08-09: the loop above only ever touched the PODS project's own
  # targets (installer.pods_project.targets) - never Runner's own target
  # in Runner.xcodeproj. Confirmed via a real build log that the actual
  # `Ld` invocation for Runner DOES correctly include `-force_load
  # .../libgit2.a`, and lib/STRUCTURE.md's Swift `@_silgen_name` fix in
  # AppDelegate.swift creates a real undefined-symbol reference that
  # should make git_libgit2_init survive the link-time -dead_strip pass.
  # But `nm` on the final packaged Runner.app/Runner still found no
  # trace of it - meaning something strips it AFTER linking. Xcode's
  # separate "strip symbols from installed product" build phase
  # defaults to on for Release and was never disabled on Runner's own
  # target, only on the Pods' targets above. This reaches Runner's
  # actual project/target via the aggregate target CocoaPods builds for
  # it, not the Pods project.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |native_target|
      native_target.build_configurations.each do |config|
        config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
        config.build_settings['DEPLOYMENT_POSTPROCESSING'] = 'NO'

        # 2026-08-09, second fix needed the same day: nm confirmed
        # git_libgit2_init IS compiled into the packaged Runner binary
        # (the two fixes above worked), yet the real-device error is
        # still "Failed to lookup symbol 'git_libgit2_init':
        # dlsym(RTLD_DEFAULT, git_libgit2_init): symbol not found" - a
        # DIFFERENT failure mode than before, not the same bug
        # persisting. Root cause: dlsym(RTLD_DEFAULT, ...) on iOS
        # resolves against each loaded image's EXPORT TRIE, not its raw
        # symbol table. Dylibs get an export trie automatically; the
        # MAIN APP EXECUTABLE does not, by default. -force_load/
        # -all_load only control whether code gets linked in, not
        # whether it's in the export trie afterward - a fully separate
        # concern. -exported_symbols_list explicitly tells the linker
        # to add matching symbols to Runner's own export trie.
        # Wildcarding `_git_*` covers the whole libgit2 C API surface
        # git2dart's Dart FFI bindings call into (not just init/
        # shutdown), so this doesn't need updating every time a new
        # libgit2 function gets called for the first time.
        existing_ldflags = config.build_settings['OTHER_LDFLAGS']
        export_flags = ['-Xlinker', '-exported_symbols_list', '-Xlinker', '"$(SRCROOT)/Runner/git2dart_exported_symbols.txt"']
        case existing_ldflags
        when Array
          config.build_settings['OTHER_LDFLAGS'] = existing_ldflags + export_flags
        when String
          config.build_settings['OTHER_LDFLAGS'] = "#{existing_ldflags} #{export_flags.join(' ')}"
        else
          config.build_settings['OTHER_LDFLAGS'] = ['$(inherited)'] + export_flags
        end
      end
    end
    aggregate_target.user_project.save
  end
end
