platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Fix for Dart FFI dlsym symbol lookup failing in Release builds
      # ("Failed to lookup symbol 'git_libgit2_init'") - a known Dart FFI
      # issue (dart-lang/native#897): Release-mode dead-code-stripping
      # removes C symbols not directly referenced by Swift/ObjC, even
      # when genuinely statically linked (git2dart/libgit2/libssh2/
      # OpenSSL via git2dart_binaries). -all_load forces the linker to
      # keep every symbol from every linked static library. Confirmed
      # 2026-08-08 real-device run hit this exact error.
      config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
      config.build_settings['OTHER_LDFLAGS'] << '-all_load'

      # -all_load alone wasn't enough (confirmed 2026-08-08, same error
      # persisted after it) - it only stops the linker dropping whole
      # unreferenced object files during linking. Separately, Release
      # builds strip the symbol table from the FINAL installed binary
      # afterward, which is what dlsym() (Dart FFI's runtime lookup
      # mechanism) actually depends on. Disabling that post-link
      # stripping is the other half of this fix.
      config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
      config.build_settings['DEPLOYMENT_POSTPROCESSING'] = 'NO'
    end
  end
end
