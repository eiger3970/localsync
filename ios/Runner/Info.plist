	<!-- Required for canLaunchUrl('obsidian://') to work at all - iOS
	     always returns false for canOpenURL on schemes not explicitly
	     whitelisted here, regardless of whether the app is actually
	     installed. Missing entirely until 2026-08-09, so ios_app_service
	     .dart's Obsidian-installed check always reported "not installed"
	     even when it was. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>obsidian</string>
	</array>
	<!-- 2026-09-16: Home Screen widget's Push/Pull buttons are plain
	     SwiftUI Link(destination:) URLs (localsync://push,
	     localsync://pull), not an AppIntent - deliberately avoids
	     needing App Groups/entitlements (Developer Portal registration
	     may not work on a free/sideload signing identity), reusing the
	     exact same pendingQuickAction mechanism already built for Quick
	     Actions, just triggered by AppDelegate's URL handler instead of
	     the quick_actions plugin's callback. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kworld.localsync.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>localsync</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>LocalSync connects to your paired desktop over your local network to sync your Obsidian vault.</string>
	<!-- 2026-08-21: auto-discovery - lets the app find the desktop's
	     Git bare repo automatically instead of manual IP entry. Real
	     scope note: still unverified whether iOS actually requires
	     this for a pure-Dart raw-socket multicast query (multicast_dns
	     package) the same way it does for Apple's own NetServiceBrowser
	     API - added as the documented-correct, safe precaution either
	     way. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_localsync._tcp</string>
	</array>
	<!-- 2026-09-04: Settings fields 3/4's own QR scan button - lets a
	     user scan the desktop's git bare repo / vault path off screen
	     (or a printed/QR'd setup result) instead of typing or
	     copy-pasting a long path that can get corrupted by OCR line
	     wrapping. -->
	<key>NSCameraUsageDescription</key>
	<string>LocalSync uses your camera to scan a QR code shown on your desktop, so you don't have to type or paste a long path by hand.</string>
</dict>
